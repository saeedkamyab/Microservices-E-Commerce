@using BackOffice.Components.Components.Shared;

<div class="card">
    <div class="card-header card-header_Container">
        <h5 class="mb-0">Categories</h5>
        <button class="btn btn-primary"
                @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>

    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="alert alert-success">
                @SuccessMessage
            </div>
        }
        <div class="row g-2 mb-3">

            <div class="col-md-6">
                <input class="form-control"
                       placeholder="Search categories..."
                       @bind="Search" />
            </div>

            <div class="col-md-3">
                <select class="form-select"
                        @bind="Status">
                    <option value="">All statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <div class="col-md-3">
                <button class="btn btn-primary w-100"
                        @onclick="SearchAsync"
                        disabled="@IsLoading">
                    Search
                </button>
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        @if (IsLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border"
                     role="status">
                </div>

                <div class="mt-2">
                    Loading categories...
                </div>
            </div>
        }
        else if (Result is null || Result.Items.Count == 0)
        {
            <div class="alert alert-light border">
                No categories found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Parent</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Result.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@category.Name</strong>
                                </td>

                                <td>
                                    @(category.ParentCategoryName ?? "—")
                                </td>

                                <td>
                                    @category.Status
                                </td>

                                <td class="text-end">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" 
                                                id="@($"status-{category.Id}")"
                                                checked="@(category.Status == "Active")" 
                                               @onchange="async e => await ChangeStatusAsync(category,e.Value is bool isActive && isActive)">

                                        <label class="form-check-label" for="@($"status-{category.Id}")"> @category.Status</label>

                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="d-flex justify-content-between
                align-items-center mt-3">

                <div class="text-muted">
                    Page @Result.PageNumber
                    of @Result.TotalPages
                    — @Result.TotalCount.ToString("N0") categories
                </div>

                <div>

                    <button class="btn btn-outline-secondary me-2"
                            disabled="@(!Result.HasPreviousPage || IsLoading)"
                            @onclick="PreviousPageAsync">
                        Previous
                    </button>

                    <button class="btn btn-outline-secondary"
                            disabled="@(!Result.HasNextPage || IsLoading)"
                            @onclick="NextPageAsync">
                        Next
                    </button>

                </div>

            </div>
        }

    </div>
</div>


<Modal Title="Create Category"
       @bind-IsVisible="IsCreateModalVisible">

    <CreateCategoryForm OnCreated="HandleCategoryCreated" />

</Modal>